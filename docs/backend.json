
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user within the CampusConnect platform, including students, faculty, and administrators.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "name": {
          "type": "string",
          "description": "The full name of the user."
        },
        "email": {
          "type": "string",
          "description": "The email address of the user, used for login and notifications.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The role of the user within the platform (e.g., 'student', 'faculty', 'admin')."
        },
        "departmentId": {
          "type": "string",
          "description": "Reference to the Department this user belongs to."
        },
        "auditStatus": {
          "type": "string",
          "enum": ["pending", "verified"],
          "description": "The institutional verification status of the persona."
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "role",
        "auditStatus"
      ]
    },
    "Department": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Department",
      "type": "object",
      "description": "Represents an academic or administrative department.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "code"]
    },
    "Course": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Course",
      "type": "object",
      "description": "Represents an academic course.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "credits": { "type": "number" }
      },
      "required": ["id", "name", "code", "credits"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "courseId": { "type": "string" }
      },
      "required": ["id", "studentId", "courseId"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "entityName": "User", "description": "User profiles and verification status." } },
      { "path": "/courses/{courseId}", "definition": { "entityName": "Course", "description": "Global academic catalog." } }
    ]
  }
}
